{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh-plugin-market",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/plugins",
      "/plugins/*",
      "/plugin/*",
      "/publisher/*",
      "/guide",
      "/guide/*",
      "/submit",
      "/submit/*",
      "/about",
      "/about/*",
      "/trust",
      "/trust/*",
      "/sitemap.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-plugin-market",
      "database_id": "6795368a-e2e3-485d-aadf-acc04f92561a",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "dsh-plugin-scan" }],
    "consumers": [
      {
        "queue": "dsh-plugin-scan",
        "max_batch_size": 5,
        "max_concurrency": 5,
        "max_retries": 5
      }
    ]
  },
  "vars": {
    "AUTO_FEATURE_MIN_STARS": "1000"
  },
  "triggers": {
    "crons": ["0 * * * *", "30 0 * * * *"]
  }
}
