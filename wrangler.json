{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh-plugin-market",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/plugins",
      "/plugins/*",
		"/compare",
		"/changes",
      "/plugin/*",
      "/publisher/*",
      "/guide",
      "/guide/*",
      "/submit",
      "/submit/*",
      "/about",
      "/about/*",
      "/trust",
      "/trust/*",
      "/sitemap.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-plugin-market",
      "database_id": "6795368a-e2e3-485d-aadf-acc04f92561a",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "dsh-plugin-scan" }],
    "consumers": [
      {
        "queue": "dsh-plugin-scan",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_concurrency": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "dsh-plugin-scan-dlq"
      }
    ]
  },
  "vars": {
    "AUTO_FEATURE_MIN_STARS": "100",
    "DISCOVERY_INCREMENTAL_LIMIT": "100",
    "DISCOVERY_RECONCILE_LIMIT": "800",
    "RESCAN_DAILY_BUDGET": "250",
    "GITHUB_REQUEST_DELAY_MS": "900"
  },
  "triggers": {
    "crons": ["15 * * * *", "20 2 * * *", "5 */6 * * *", "35 3 * * *", "50 3 * * *"]
  }
}
